{
  "name": "e2e-trading-test-suite",
  "version": "1.1.0",
  "description": "Playwright TypeScript E2E portfolio suite with POM, API checks, and a local mock trading target",
  "private": true,
  "scripts": {
    "bddgen": "bddgen",
    "pretest": "npm run bddgen",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test tests/e2e",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:qa": "cross-env TEST_ENV=qa npm test",
    "test:staging": "cross-env TEST_ENV=staging npm test",
    "test:prod": "cross-env TEST_ENV=prod npm test",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps",
    "mock:server": "tsx mock-app/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "playwright",
    "typescript",
    "pom",
    "e2e",
    "trading",
    "qa"
  ],
  "author": "QA Automation",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.32.0",
    "express": "^5.1.0",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
